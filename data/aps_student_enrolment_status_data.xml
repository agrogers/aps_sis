<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="student_enrolment_status_inquiry" model="aps.student.enrolment.status">
            <field name="name">Inquiry</field>
            <field name="code">inquiry</field>
            <field name="sequence">10</field>
            <field name="description">Prospective student whose application is under consideration.</field>
            <field name="color">4</field>
        </record>
        <record id="student_enrolment_status_waiting" model="aps.student.enrolment.status">
            <field name="name">Waiting</field>
            <field name="code">waiting</field>
            <field name="sequence">20</field>
            <field name="description">Accepted for processing or awaiting a start date.</field>
            <field name="color">3</field>
        </record>
        <record id="student_enrolment_status_accepted" model="aps.student.enrolment.status">
            <field name="name">Accepted</field>
            <field name="code">accepted</field>
            <field name="sequence">30</field>
            <field name="description">Offer accepted; student has not yet started.</field>
            <field name="color">2</field>
        </record>
        <record id="student_enrolment_status_enrolled" model="aps.student.enrolment.status">
            <field name="name">Enrolled</field>
            <field name="code">enrolled</field>
            <field name="sequence">40</field>
            <field name="description">Currently enrolled at the school.</field>
            <field name="color">10</field>
        </record>
        <record id="student_enrolment_status_completed" model="aps.student.enrolment.status">
            <field name="name">Completed</field>
            <field name="code">completed</field>
            <field name="sequence">50</field>
            <field name="description">Completed the applicable programme of study.</field>
            <field name="color">10</field>
        </record>
        <record id="student_enrolment_status_left" model="aps.student.enrolment.status">
            <field name="name">Left</field>
            <field name="code">left</field>
            <field name="sequence">60</field>
            <field name="description">No longer enrolled at the school.</field>
            <field name="color">1</field>
        </record>
        <record id="student_enrolment_status_withdrawn" model="aps.student.enrolment.status">
            <field name="name">Withdrawn</field>
            <field name="code">withdrawn</field>
            <field name="sequence">70</field>
            <field name="description">Withdrew before completing enrolment or study.</field>
            <field name="color">1</field>
        </record>
        <record id="student_enrolment_status_graduated" model="aps.student.enrolment.status">
            <field name="name">Graduated</field>
            <field name="code">graduated</field>
            <field name="sequence">80</field>
            <field name="description">Graduated from the school.</field>
            <field name="color">10</field>
        </record>
    </data>
</odoo>