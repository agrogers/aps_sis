<templates xml:space="preserve">
    <t t-name="aps_sis.TeacherWorkloadProfile">
        <main class="aps-teacher-workload-profile">
            <header class="aps-twp__header">
                <div>
                    <p class="aps-twp__eyebrow">Teacher Workload</p>
                    <h1 t-if="state.profile"><t t-esc="state.profile.teacher_name"/></h1>
                    <h1 t-else="">Workload Profile</h1>
                </div>
                <button class="btn btn-primary aps-twp__print-button" t-on-click="printPage">
                    <i class="fa fa-print me-1"/> Print
                </button>
            </header>

            <t t-if="state.loading">
                <div class="aps-twp__message" role="status">Loading workload data...</div>
            </t>
            <t t-elif="state.error">
                <div class="alert alert-warning" role="alert"><t t-esc="state.error"/></div>
            </t>
            <t t-else="">
                <section class="aps-twp__summary" aria-label="Workload summary">
                    <div t-attf-class="aps-twp__metric {{ getLoadStatusClass(getTeachingLoadPercentage()) }}">
                        <span class="aps-twp__metric-label">Teaching</span>
                        <strong>
                            <t t-esc="formatMinutes(state.profile.lead_total)"/>
                            <span class="aps-twp__metric-unit">mins</span> /
                            <t t-if="getTeachingLoadPercentage() !== null">
                                <t t-esc="formatPercentage(getTeachingLoadPercentage())"/>%
                                <span class="aps-twp__metric-unit">of maximum</span>
                            </t>
                            <t t-else="">N/A</t>
                        </strong>
                        <span t-if="getTeachingLoadPercentage() === null" class="aps-twp__metric-hours">
                            No maximum set
                        </span>
                        <span class="aps-twp__metric-note">
                            FTE: <t t-esc="formatFte(state.profile.teaching_load_fte)"/>
                        </span>
                    </div>
                    <div t-attf-class="aps-twp__metric {{ getLoadStatusClass(getNonTeachingLoadPercentage()) }}">
                        <span class="aps-twp__metric-label">Non-Teaching Load</span>
                        <strong>
                            <t t-esc="formatMinutes(state.profile.assistant_total)"/>
                            <span class="aps-twp__metric-unit">mins</span> /
                            <t t-if="getNonTeachingLoadPercentage() !== null">
                                <t t-esc="formatPercentage(getNonTeachingLoadPercentage())"/>%
                                <span class="aps-twp__metric-unit">of maximum</span>
                            </t>
                            <t t-else="">N/A</t>
                        </strong>
                        <span t-if="getNonTeachingLoadPercentage() === null" class="aps-twp__metric-hours">
                            No maximum set
                        </span>
                        <span class="aps-twp__metric-note">
                            FTE: <t t-esc="formatFte(state.profile.non_teaching_load_fte)"/>
                        </span>
                    </div>
                    <div class="aps-twp__metric aps-twp__metric--department">
                        <span class="aps-twp__metric-label">Department</span>
                        <strong><t t-esc="state.profile.department_name"/></strong>
                    </div>
                </section>

                <section t-if="state.profile.roles.length" class="aps-twp__roles" aria-label="Roles">
                    <div class="aps-twp__roles-grid">
                        <article t-foreach="state.profile.roles" t-as="role" t-key="role.label"
                                 t-attf-class="aps-twp__role {{ role.job !== 'Not assigned' ? '' : 'aps-twp__role--unassigned' }}"
                                 t-att-aria-hidden="role.job !== 'Not assigned' ? 'false' : 'true'">
                            <h3><t t-esc="role.label"/></h3>
                            <dl>
                                <div>
                                    <dt>Job</dt>
                                    <dd><t t-esc="role.job"/></dd>
                                </div>
                                <div>
                                    <dt>Department</dt>
                                    <dd><t t-esc="role.department"/></dd>
                                </div>
                                <div>
                                    <dt>FTE</dt>
                                    <dd><t t-esc="formatFte(role.fte)"/></dd>
                                </div>
                            </dl>
                        </article>
                    </div>
                </section>

                <section class="aps-twp__chart aps-twp__chart--total">
                    <div class="aps-twp__chart-heading">
                        <span class="aps-twp__chart-index">01</span>
                        <div>
                            <h2>Teaching and Non-Teaching Load vs Maximum</h2>
                            <p>Each dashed marker indicates the maximum for its load type.</p>
                        </div>
                    </div>
                    <div class="aps-twp__chart-wrap aps-twp__chart-wrap--total">
                        <canvas t-ref="loadChart" role="img" aria-label="Teaching and non-teaching workload compared with their respective maximums"></canvas>
                    </div>
                </section>

                <section class="aps-twp__chart aps-twp__chart--subjects">
                    <div class="aps-twp__chart-heading">
                        <span class="aps-twp__chart-index">02</span>
                        <div>
                            <h2>Minutes by Subject</h2>
                            <p>Lead and assistant assignments</p>
                        </div>
                    </div>
                    <t t-if="state.profile.subjects.length">
                        <div class="aps-twp__chart-wrap aps-twp__chart-wrap--subjects">
                            <canvas t-ref="subjectChart" role="img" aria-label="Stacked minutes by subject"></canvas>
                        </div>
                    </t>
                    <p t-else="" class="aps-twp__empty">No timetable workload is linked to this teacher.</p>
                </section>

                <footer class="aps-twp__footer">
                    <a href="https://docs.google.com/document/d/1CyssPsk07qd8PPWh8lv2IUWn8kOlHWQgSw2F6m57h-0/edit?tab=t.0"
                       target="_blank" rel="noopener noreferrer">
                        Teaching  and non-teaching loads are explained in this school policy document.
                    </a>
                </footer>
            </t>
        </main>
    </t>
</templates>
