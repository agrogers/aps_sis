<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="aps_sis.SchoolCalendarReport" owl="1">
    <div class="scr-wrap vh-100 overflow-auto p-3 bg-100">

        <!-- Toolbar -->
        <div class="d-flex align-items-center gap-3 mb-3">
            <label class="fw-semibold mb-0">Academic Year</label>
            <select class="form-select w-auto" t-on-change="onYearChange">
                <t t-foreach="state.years" t-as="year" t-key="year.id">
                    <option t-att-value="year.id"
                            t-att-selected="year.id === state.yearId"
                            t-esc="year.short_name || year.name"/>
                </t>
            </select>
        </div>

        <!-- Calendar sheet -->
        <div class="scr-sheet mx-auto bg-white shadow p-4">

            <!-- Header -->
            <div class="scr-header d-flex align-items-center mb-2">
                <img t-if="state.logoUrl" t-att-src="state.logoUrl"
                     class="scr-logo me-3" alt="Logo"/>
                <h1 class="scr-title flex-grow-1 text-center mb-0">
                    <t t-esc="state.yearName"/> ACADEMIC CALENDAR
                </h1>
            </div>

            <!-- Semester summary -->
            <t t-if="state.semesters and state.semesters.length">
                <table class="scr-sem-wrap w-100 mb-3">
                    <tr>
                        <t t-foreach="state.semesters" t-as="sem" t-key="sem.name">
                            <td class="align-top px-2">
                                <table class="scr-sem-table w-100">
                                    <tr class="scr-sem-head">
                                        <th t-att-colspan="sem.terms ? 4 : 2" t-esc="sem.name"/>
                                    </tr>
                                    <tr class="scr-sem-sub">
                                        <t t-if="sem.terms">
                                            <th>Term</th><th>Weeks</th><th>Days</th><th>Dates</th>
                                        </t>
                                        <t t-else="">
                                            <th>Weeks</th><th>Days</th>
                                        </t>
                                    </tr>
                                    <t t-if="sem.terms">
                                        <tr t-foreach="sem.terms" t-as="row" t-key="row_index">
                                            <td t-esc="row.term"/>
                                            <td t-esc="row.weeks"/>
                                            <td t-esc="row.days"/>
                                            <td t-esc="row.dates"/>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td t-esc="sem.weeks"/>
                                            <td t-esc="sem.days"/>
                                        </tr>
                                        <tr>
                                            <td colspan="2" class="scr-sem-note">Calendar is subject to change.</td>
                                        </tr>
                                    </t>
                                </table>
                            </td>
                        </t>
                    </tr>
                    <tr>
                        <td colspan="100" class="scr-sem-legend-cell">
                            <t t-foreach="state.semesters[2].legend || []" t-as="item" t-key="item.name">
                                <span class="scr-sem-legend-item">
                                    <span class="scr-sem-legend-swatch" t-attf-style="background-color: {{ item.color }}"/>
                                    <span t-esc="item.name"/>
                                </span>
                            </t>
                        </td>
                    </tr>
                </table>
            </t>

            <!-- Month rows: events | month | month | events -->
            <t t-foreach="monthRows" t-as="row" t-key="row_index">
                <table class="scr-row w-100 mb-2">
                    <tr>
                        <td class="scr-events-cell scr-events-left">
                            <t t-if="row[0]">
                                <table class="scr-event-list scr-event-list-right">
                                    <tr t-foreach="row[0].events" t-as="ev" t-key="ev_index">
                                        <td class="scr-ev-entry">
                                            <span class="scr-ev-title" t-esc="ev.title"/>
                                            <span class="scr-ev-badge"
                                                  t-attf-style="background-color: {{ ev.color }}; {{ (!ev.color || ev.color.toUpperCase() === '#FFFFFF') ? 'color:#000; border:1px solid #999;' : '' }}"
                                                  t-esc="ev.dates"/>
                                        </td>
                                    </tr>
                                </table>
                            </t>
                        </td>
                        <td class="scr-month-cell">
                            <t t-if="row[0]">
                                <t t-call="aps_sis.SchoolCalendarMonth">
                                    <t t-set="month" t-value="row[0]"/>
                                </t>
                            </t>
                        </td>
                        <td class="scr-month-cell">
                            <t t-if="row[1]">
                                <t t-call="aps_sis.SchoolCalendarMonth">
                                    <t t-set="month" t-value="row[1]"/>
                                </t>
                            </t>
                        </td>
                        <td class="scr-events-cell scr-events-right">
                            <t t-if="row[1]">
                                <table class="scr-event-list">
                                    <tr t-foreach="row[1].events" t-as="ev" t-key="ev_index">
                                        <td class="scr-ev-entry">
                                            <span class="scr-ev-badge"
                                                  t-attf-style="background-color: {{ ev.color }}; {{ (!ev.color || ev.color.toUpperCase() === '#FFFFFF') ? 'color:#000; border:1px solid #999;' : '' }}"
                                                  t-esc="ev.dates"/>
                                            <span class="scr-ev-title" t-esc="ev.title"/>
                                        </td>
                                    </tr>
                                </table>
                            </t>
                        </td>
                    </tr>
                </table>
            </t>

        </div>
    </div>
</t>

<!-- Single month panel; expects `month` in scope -->
<t t-name="aps_sis.SchoolCalendarMonth" owl="1">
    <div class="scr-month">
        <div class="scr-month-title" t-esc="month.label"/>
        <table t-attf-class="scr-grid #{month.weeks.some(w => w.saturday) ? 'has-saturday' : ''}">
            <tr class="scr-weekdays">
                <th>M</th><th>T</th><th>W</th><th>T</th><th>F</th><th class="scr-sat-hd"><t t-if="month.weeks.some(w => w.saturday)">S</t></th>
            </tr>
            <t t-foreach="month.weeks" t-as="week" t-key="week_index">
                <tr>
                    <t t-foreach="week.days" t-as="cell" t-key="cell_index">
                        <td t-attf-class="scr-day #{cell and cell.day ? '' : 'scr-empty'}"
                            t-attf-style="#{(cell and cell.color and cell.color !== '#FFFFFF' ? 'background-color:' + cell.color + ';' : '') + (cell and (!cell.color || cell.color.toUpperCase() === '#FFFFFF') ? 'color:#000;' : '')} position:relative;">
                            <t t-esc="cell ? cell.day or '' : ''"/>
                            <img t-if="cell and cell.icon_url" class="scr-cell-icon"
                                 t-att-src="cell.icon_url" alt=""/>
                        </td>
                    </t>
                    <td t-if="week.saturday" class="scr-day scr-saturday"
                        t-attf-style="background-color: {{ week.saturday.color }}; {{ week.saturday.color &amp;&amp; week.saturday.color.toUpperCase() === '#FFFFFF' ? 'color:#000;' : '' }}"
                        t-esc="week.saturday.day"/>
                    <t t-else="">
                        <td class="scr-sat-hidden"/>
                    </t>
                </tr>
            </t>
        </table>
    </div>
</t>

</templates>
