<templates xml:space="preserve">
    <t t-name="aps_sis.ExamSectionPagePicker">
        <Dialog title="props.documentType === 'question' ? 'Add Question Page' : 'Add Mark Scheme Page'" size="'xl'">
            <div class="o_exam_region_page_picker">
                <div class="text-muted mb-3">
                    Choose a rendered page. The standard crop will be added and can be adjusted before saving.
                </div>
                <div class="o_exam_region_page_grid">
                    <t t-foreach="props.pages || []" t-as="page" t-key="page.id">
                        <button type="button" class="o_exam_region_page_card" t-on-click="() => this.selectPage(page)">
                            <div class="o_exam_region_page_card_title">
                                <strong>
                                    <span t-if="props.documentType === 'question'">Question Paper</span>
                                    <span t-else="">Mark Scheme</span>
                                    — Page <t t-esc="page.page_number"/>
                                </strong>
                            </div>
                            <div class="o_exam_region_page_thumbnail">
                                <img t-att-src="page.image_url" alt="Rendered exam page"></img>
                            </div>
                        </button>
                    </t>
                    <div class="text-muted text-center p-4" t-if="!(props.pages || []).length">
                        No rendered pages are available for this document type.
                    </div>
                </div>
            </div>
        </Dialog>
    </t>

    <t t-name="aps_sis.ExamSectionRegionEditor">
        <div class="o_exam_region_editor_modal">
            <div class="o_exam_region_editor_header justify-content-between">
                <div class="o_exam_region_editor_title">
                    <label class="visually-hidden" for="o_exam_region_editor_name">Section name</label>
                    <input id="o_exam_region_editor_name" class="form-control o_exam_region_editor_name"
                           type="text" t-att-value="state.data?.label || ''"
                           t-on-input="onLabelInput" t-att-disabled="!state.data || state.saving"/>
                    <span class="text-muted" t-if="state.data?.navigation?.count">
                        Section <t t-esc="state.data.navigation.position"/> of <t t-esc="state.data.navigation.count"/>
                    </span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" t-on-click="copyPages" t-att-disabled="!regions.length || state.saving" title="Copy all pages and regions">
                        <i class="fa fa-copy me-1"></i> Copy Pages
                    </button>
                    <button type="button" class="btn btn-outline-secondary" t-on-click="pastePages" t-att-disabled="!state.pageClipboard.length || state.saving" title="Paste copied pages into this section">
                        <i class="fa fa-paste me-1"></i> Paste
                    </button>
                    <button type="button" class="btn btn-outline-primary" t-on-click="() => this.addPage('question')" t-att-disabled="!state.data || state.saving">
                        <i class="fa fa-plus me-1"></i> Add Question Page
                    </button>
                    <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.addPage('mark_scheme')" t-att-disabled="!state.data || state.saving">
                        <i class="fa fa-plus me-1"></i> Add Mark Scheme Page
                    </button>
                    <button type="button" class="btn btn-outline-danger" t-if="state.selected"
                            t-on-click="() => this.toggleAddExclusionZone()"
                            t-att-disabled="state.saving"
                            t-att-title="state.addingExclusionZone ? 'Cancel drawing an exclusion zone' : 'Draw an exclusion zone on this page'">
                        <i t-att-class="state.addingExclusionZone ? 'fa fa-times me-1' : 'fa fa-plus me-1'"></i>
                        <t t-if="state.addingExclusionZone">Cancel Zone</t>
                        <t t-else="">Add Exclusion Zone</t>
                    </button>
                </div>
            </div>
            <div class="o_exam_region_editor_content" t-if="state.data">
                <div class="o_exam_region_cards">
                    <t t-foreach="regions" t-as="region" t-key="this._regionKey(region)">
                        <div class="o_exam_region_card">
                            <div class="o_exam_region_card_header">
                                <button type="button" class="o_exam_region_card_select" t-on-click="() => this.selectRegion(region)" t-att-disabled="state.saving">
                                    <div class="o_exam_region_card_title">
                                        <span t-if="region.document_type === 'question'">Question</span>
                                        <span t-else="">Mark Scheme</span>
                                        — Page <t t-esc="region.page_number"/>
                                    </div>
                                </button>
                                <button type="button" class="btn btn-sm btn-link text-danger" title="Remove image from section" aria-label="Remove image from section" t-on-click="(event) => this.removeRegion(event, region)" t-att-disabled="state.saving">
                                    <i class="fa fa-trash"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-link" title="Copy page" aria-label="Copy page" t-on-click="() => this.copyRegion(region)" t-att-disabled="state.saving">
                                    <i class="fa fa-copy"></i>
                                </button>
                            </div>
                            <button type="button" class="o_exam_region_card_preview" t-on-click="() => this.selectRegion(region)" t-att-style="previewStyle(region)" aria-label="Select page">
                                <img t-att-src="region.image_url" t-att-style="previewImageStyle(region)" alt="Detected exam section"/>
                            </button>
                            <div class="o_exam_region_card_label"><t t-esc="region.label"/></div>
                        </div>
                    </t>
                    <div class="text-muted" t-if="!regions.length">No detected regions for this document type.</div>
                </div>
                <div class="o_exam_region_editor_page" t-if="state.selected">
                    <div class="o_exam_region_image_wrap"
                         t-att-class="state.addingExclusionZone ? 'is-adding-exclusion' : ''"
                         t-on-pointerdown="(event) => this.startExclusionDraw(event)">
                        <img t-att-src="state.selected.image_url" alt="Full rendered exam page"></img>
                        <div class="o_exam_region_overlay" t-att-style="draftStyle()">
                            <span class="o_exam_region_handle left" t-on-pointerdown="(event) => this.startDrag(event, 'left')"></span>
                            <span class="o_exam_region_handle right" t-on-pointerdown="(event) => this.startDrag(event, 'right')"></span>
                            <span class="o_exam_region_handle top" t-on-pointerdown="(event) => this.startDrag(event, 'top')"></span>
                            <span class="o_exam_region_handle bottom" t-on-pointerdown="(event) => this.startDrag(event, 'bottom')"></span>
                            <span class="o_exam_region_overlay_label"><t t-esc="state.selected.label"/></span>
                        </div>
                        <t t-foreach="state.exclusionRegions" t-as="zone" t-key="zone.id">
                            <div class="o_exam_exclusion_overlay" t-att-style="exclusionStyle(zone)">
                                <div class="o_exam_exclusion_body"
                                     t-on-pointerdown="(event) => this.startZoneDrag(event, zone, 'move')"></div>
                                <span class="o_exam_region_handle left o_exam_exclusion_handle"
                                      t-on-pointerdown="(event) => this.startZoneDrag(event, zone, 'left')"></span>
                                <span class="o_exam_region_handle right o_exam_exclusion_handle"
                                      t-on-pointerdown="(event) => this.startZoneDrag(event, zone, 'right')"></span>
                                <span class="o_exam_region_handle top o_exam_exclusion_handle"
                                      t-on-pointerdown="(event) => this.startZoneDrag(event, zone, 'top')"></span>
                                <span class="o_exam_region_handle bottom o_exam_exclusion_handle"
                                      t-on-pointerdown="(event) => this.startZoneDrag(event, zone, 'bottom')"></span>
                                <span class="o_exam_exclusion_label">
                                    Exclusion - <t t-esc="zone.source === 'ai' ? 'AI' : 'Manual'"/>
                                </span>
                                <button type="button" class="o_exam_exclusion_delete"
                                        title="Delete exclusion zone" aria-label="Delete exclusion zone"
                                        t-on-pointerdown="(event) => event.stopPropagation()"
                                        t-on-click="(event) => this.removeExclusionZone(event, zone)">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </t>
                        <div class="o_exam_exclusion_overlay o_exam_exclusion_draft"
                             t-if="state.zoneDraft?.id === 'draft-zone'"
                             t-att-style="zoneDraftStyle()"></div>
                    </div>
                </div>
            </div>
            <div class="o_exam_region_editor_footer">
                <span class="text-muted" t-if="state.saving || state.savingLabel">Saving…</span>
                <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.navigateTo(state.data.navigation.previous)" t-att-disabled="!state.data?.navigation?.previous || state.saving">
                    <i class="fa fa-chevron-left me-1"></i> Previous
                </button>
                <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.navigateTo(state.data.navigation.next)" t-att-disabled="!state.data?.navigation?.next || state.saving">
                    Next <i class="fa fa-chevron-right ms-1"></i>
                </button>
                <button type="button" class="btn btn-secondary ms-auto" t-on-click="close" t-att-disabled="state.saving">Close</button>
            </div>
        </div>
    </t>
</templates>
