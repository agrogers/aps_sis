<templates xml:space="preserve">
    <t t-name="aps_sis.WeeklySubmissionResults">
        <div class="o_aps_weekly_results d-flex flex-column vh-100 overflow-hidden bg-light">
            <div class="o_aps_weekly_results__filters bg-white border-bottom p-3 d-flex align-items-end gap-3 flex-wrap">
                <div>
                    <label class="form-label small mb-1">Academic Period</label>
                    <select class="form-select form-select-sm" t-model="state.academicTermId" t-on-change="onTermChange">
                        <option value="">All periods</option>
                        <t t-foreach="state.terms" t-as="term" t-key="term.id">
                            <option t-att-value="term.id"><t t-esc="term.name"/></option>
                        </t>
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-1">From</label>
                    <input type="date" class="form-control form-control-sm" t-model="state.startDate" t-on-change="onChangeFilter"/>
                </div>
                <div>
                    <label class="form-label small mb-1">To</label>
                    <input type="date" class="form-control form-control-sm" t-model="state.endDate" t-on-change="onChangeFilter"/>
                </div>
                <div t-if="state.students.length">
                    <label class="form-label small mb-1">Student</label>
                    <select class="form-select form-select-sm" t-model="state.studentId" t-on-change="onChangeFilter">
                        <t t-foreach="state.students" t-as="student" t-key="student.id">
                            <option t-att-value="student.id"><t t-esc="student.name"/></option>
                        </t>
                    </select>
                </div>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        Resource Types (<t t-esc="state.selectedTypeIds === null ? 'All' : state.selectedTypeIds.length"/>)
                    </button>
                    <div class="dropdown-menu p-2">
                        <div class="d-flex gap-2 mb-2">
                            <button class="btn btn-sm btn-outline-primary" t-on-click="selectAllTypes" t-on-mousedown.stop="onTypeMenuControlMouseDown">All</button>
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="selectNoTypes" t-on-mousedown.stop="onTypeMenuControlMouseDown">None</button>
                        </div>
                        <t t-foreach="state.types" t-as="type" t-key="type.id">
                            <label class="dropdown-item d-flex align-items-center gap-2">
                                <input type="checkbox" t-att-checked="typeSelected(type.id)" t-on-change="() => toggleType(type.id)"/>
                                <span><t t-esc="type.name"/></span>
                            </label>
                        </t>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-primary ms-auto" t-on-click="load">Refresh</button>
            </div>

            <div t-if="state.error" class="alert alert-danger m-3"><t t-esc="state.error"/></div>
            <div t-if="state.loading" class="d-flex justify-content-left p-5">
                <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading</span></div>
            </div>
            <div t-else="" class="o_aps_weekly_results__scroll flex-grow-1 overflow-auto">
                <table class="table table-sm table-bordered mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="o_aps_weekly_results__sticky-column">Subject</th>
                            <th class="o_aps_weekly_results__total-column text-center">Total</th>
                            <t t-foreach="state.weeks" t-as="week" t-key="week.start">
                                <th t-att-class="week.is_non_school ? 'o_aps_weekly_results__non-school text-center' : 'text-center'">
                                    <div><t t-esc="week.label"/></div>
                                    <small t-if="week.academic_week_name"><t t-esc="week.academic_week_name"/></small>
                                </th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="groupedRows" t-as="group" t-key="group.key">
                            <tr class="o_aps_weekly_results__subject-heading">
                                <th class="o_aps_weekly_results__sticky-column bg-white border-0">
                                    <span t-if="group.subjectIconUrl" class="o_aps_weekly_results__subject-icon">
                                        <img t-att-src="group.subjectIconUrl" t-att-alt="group.subjectName"/>
                                    </span>
                                    <span class="fw-semibold"><t t-esc="group.subjectName"/></span>
                                </th>
                                <!-- <t t-foreach="state.weeks" t-as="week" t-key="week.start">
                                    <td class="o_aps_weekly_results__subject-background border-0"
                                        t-att-style="group.subjectIconUrl &amp;&amp; (week_index % 3 === 2) ? 'background-image: url(' + group.subjectIconUrl + ');' : ''"></td>
                                </t> -->
                            </tr>
                            <t t-foreach="group.rows" t-as="row" t-key="row.key">
                            <tr>
                                <th class="o_aps_weekly_results__sticky-column bg-white o_aps_weekly_results__type-label">
                                    <span t-if="row.type_icon_url" class="o_aps_weekly_results__type-icon">
                                        <img t-att-src="row.type_icon_url" t-att-alt="row.type_name"/>
                                    </span>
                                    <span class=""><t t-esc="row.type_name"/></span>
                                </th>
                                <td class="o_aps_weekly_results__total-column text-center p-1">
                                    <a t-if="row.total.submission_count" href="#" class="o_aps_weekly_results__cell o_aps_weekly_results__cell--metrics d-inline-flex align-items-center" t-on-click.prevent="() => onCellClick(row.total)" t-att-title="row.total.tooltip">
                                        <span class="badge o_aps_weekly_results__submission-count" t-if="!row.total.is_progress" title="Total Submissions"><t t-esc="row.total.submission_count"/></span>
                                        <span class="o_aps_weekly_results__percent-pie-slot">
                                            <PercentPie t-if="row.total.show_percent &amp;&amp; !row.total.is_progress" value="row.total.percent_label" string="" showValue="false" showText="false" showTooltip="true"/>
                                        </span>
                                        <span t-if="row.total.show_percent &amp;&amp; row.total.is_progress" class="o_aps_weekly_results__progress-percent" title="Progress Percentage"><t t-esc="Math.round(row.total.percent_label)"/>%</span>
                                        <span class="o_aps_weekly_results__marks" title="Total Question Marks"><t t-if="row.total.show_marks">/<t t-esc="row.total.marks_label"/></t></span>
                                    </a>
                                </td>
                                <t t-foreach="row.cells" t-as="cell" t-key="cell.key">
                                    <td t-att-class="cell.is_non_school ? 'o_aps_weekly_results__non-school text-center p-1' : 'text-center p-1'">
                                        <a t-if="cell.submission_count" href="#" class="o_aps_weekly_results__cell o_aps_weekly_results__cell--metrics d-inline-flex align-items-center" t-on-click.prevent="() => onCellClick(cell)" t-att-title="cell.tooltip">
                                            <span class="badge o_aps_weekly_results__submission-count" t-if="!cell.is_progress" title="Total Submissions" t-att-style="submissionCountStyle(cell.submission_count)"><t t-esc="cell.submission_count"/></span>
                                            <span class="o_aps_weekly_results__percent-pie-slot">
                                                <PercentPie t-if="cell.show_percent &amp;&amp; !cell.is_progress" value="cell.percent_label" string="" showValue="false" showText="false" showTooltip="true"/>
                                            </span>
                                            <span t-if="cell.show_percent &amp;&amp; cell.is_progress" class="o_aps_weekly_results__progress-percent" title="Progress Percentage"><t t-esc="Math.round(cell.percent_label)"/>%</span>
                                            <span class="o_aps_weekly_results__submission-marks o_aps_weekly_results__marks" title="Total Question Marks"><t t-if="cell.show_marks">/<t t-esc="cell.marks_label"/></t></span>
                                        </a>
                                    </td>
                                </t>
                            </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
            </div>
        </div>
    </t>
</templates>
