<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aps_sis.UniformInfringementDialog">
        <Dialog title="'Uniform infringement — ' + props.studentName" size="'md'">
            <div class="p-2">
                <p class="text-muted">Select one or more uniform concerns for this student.</p>
                <t t-foreach="this.types" t-as="item" t-key="item[0]">
                    <div class="row align-items-center mb-2">
                        <div class="col-4">
                            <label class="form-check d-flex align-items-center gap-2 mb-0">
                                <input class="form-check-input" type="checkbox" t-att-checked="this.isSelected(item[0]) ? true : undefined" t-on-change="() => this.toggleType(item[0])"></input>
                                <span t-esc="item[1]"></span>
                            </label>
                        </div>
                        <div class="col-8">
                            <input class="form-control form-control-sm" type="text" placeholder="Comment" t-att-value="this.state.comments[item[0]] || ''" t-on-input="(event) => this.updateComment(item[0], event)"></input>
                        </div>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
                <button class="btn btn-primary" t-att-disabled="this.state.saving || (!this.state.selected.size &amp;&amp; !this.existingRecords.length)" t-on-click="this.save">
                    <t t-if="this.state.saving">Saving…</t>
                    <t t-else="">Save</t>
                </button>
            </t>
        </Dialog>
    </t>
</templates>
