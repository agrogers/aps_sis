<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aps_sis.QuizProgressBar">
        <div t-if="props.summary and props.summary.progress_text"
             class="quiz-progress-summary">
            <p class="mb-2 quiz-progress-text">
                <t t-esc="props.summary.progress_text"/>
            </p>
            <div class="quiz-progress-bar" aria-hidden="true">
                <div t-if="props.summary.known_questions"
                     class="quiz-progress-segment quiz-progress-known"
                     t-att-style="'flex-basis:' + this.getWidth('known_questions') + '%'"
                     t-att-title="this.getSegmentTitle('known_questions', 'Known')"
                     t-att-aria-label="this.getSegmentTitle('known_questions', 'Known')"/>
                <div t-if="props.summary.not_known_questions"
                     class="quiz-progress-segment quiz-progress-not-known"
                     t-att-style="'flex-basis:' + this.getWidth('not_known_questions') + '%'"
                     t-att-title="this.getSegmentTitle('not_known_questions', 'Learning')"
                     t-att-aria-label="this.getSegmentTitle('not_known_questions', 'Learning')"/>
                <t t-if="props.summary.student_attempt_threshold !== 1">
                    <div t-if="props.summary.new_above_threshold"
                         class="quiz-progress-segment quiz-progress-new-above"
                         t-att-style="'flex-basis:' + this.getWidth('new_above_threshold') + '%'"
                         t-att-title="this.getSegmentTitle('new_above_threshold', 'New above threshold')"
                         t-att-aria-label="this.getSegmentTitle('new_above_threshold', 'New above threshold')"/>
                    <div t-if="props.summary.new_below_threshold"
                         class="quiz-progress-segment quiz-progress-new-below"
                         t-att-style="'flex-basis:' + this.getWidth('new_below_threshold') + '%'"
                         t-att-title="this.getSegmentTitle('new_below_threshold', 'New below threshold')"
                         t-att-aria-label="this.getSegmentTitle('new_below_threshold', 'New below threshold')"/>
                </t>
                <div t-if="props.summary.not_tried_questions"
                     class="quiz-progress-segment quiz-progress-not-tried"
                     t-att-style="'flex-basis:' + this.getWidth('not_tried_questions') + '%'"
                     t-att-title="this.getSegmentTitle('not_tried_questions', 'Not tried')"
                     t-att-aria-label="this.getSegmentTitle('not_tried_questions', 'Not tried')"/>
            </div>
            <div class="quiz-progress-legend mt-1">
                <span>
                    <span class="quiz-progress-key quiz-progress-known"/>
                    Known (<t t-esc="props.summary.known_questions"/>)
                </span>
                <t t-if="props.onFilter">
                    <span t-attf-class="quiz-progress-legend-btn {{ props.progressFilter === 'not_known' ? 'quiz-progress-legend-active' : '' }}"
                          title="Click to show only these questions"
                          t-on-click="() => props.onFilter('not_known')">
                        <span class="quiz-progress-key quiz-progress-not-known"/>Learning (<t t-esc="props.summary.not_known_questions"/>)
                    </span>
                    <t t-if="props.summary.student_attempt_threshold !== 1">
                        <span t-attf-class="quiz-progress-legend-btn {{ props.progressFilter === 'new_above_threshold' ? 'quiz-progress-legend-active' : '' }}"
                              title="Click to show only these questions"
                              t-on-click="() => props.onFilter('new_above_threshold')">
                            <span class="quiz-progress-key quiz-progress-new-above"/>✓ New (<t t-esc="props.summary.new_above_threshold"/>)
                        </span>
                        <span t-attf-class="quiz-progress-legend-btn {{ props.progressFilter === 'new_below_threshold' ? 'quiz-progress-legend-active' : '' }}"
                              title="Click to show only these questions"
                              t-on-click="() => props.onFilter('new_below_threshold')">
                            <span class="quiz-progress-key quiz-progress-new-below"/>✗ New (<t t-esc="props.summary.new_below_threshold"/>)
                        </span>
                    </t>
                    <span t-attf-class="quiz-progress-legend-btn {{ props.progressFilter === 'not_tried' ? 'quiz-progress-legend-active' : '' }}"
                          title="Click to show only these questions"
                          t-on-click="() => props.onFilter('not_tried')">
                        <span class="quiz-progress-key quiz-progress-not-tried"/>Not tried (<t t-esc="props.summary.not_tried_questions"/>)
                    </span>
                </t>
                <t t-else="">
                    <span>
                        <span class="quiz-progress-key quiz-progress-not-known"/>
                        Learning (<t t-esc="props.summary.not_known_questions"/>)
                    </span>
                    <t t-if="props.summary.student_attempt_threshold !== 1">
                        <span>
                            <span class="quiz-progress-key quiz-progress-new-above"/>✓ New (<t t-esc="props.summary.new_above_threshold"/>)
                        </span>
                        <span>
                            <span class="quiz-progress-key quiz-progress-new-below"/>✗ New (<t t-esc="props.summary.new_below_threshold"/>)
                        </span>
                    </t>
                    <span>
                        <span class="quiz-progress-key quiz-progress-not-tried"/>
                        Not tried (<t t-esc="props.summary.not_tried_questions"/>)
                    </span>
                </t>
            </div>
        </div>
    </t>
</templates>