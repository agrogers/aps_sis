<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aps_sis.SubmissionScoreField">
        <span class="d-inline-flex flex-column align-items-start submission-score-widget" title="Score">
            <span class="submission-score-label">SCORE</span>
            <span t-if="isGraded" class="d-inline-flex align-items-center gap-1 submission-score-content">
                <PercentPie value="percent"/>
                <input t-if="editable" class="submission-score-input" type="number" min="0" step="0.01" t-att-max="props.record.data.out_of_marks" t-att-value="props.record.data.score" t-att-style="'width: ' + scoreInputWidth + ';'" t-on-change="onScoreChange"/>
                <span t-else="" class="submission-score-value"><t t-esc="score" /></span><span class="mx-0">/</span><span class="submission-score-out-of"><t t-esc="outOfMarks"/></span>
            </span>
            <span t-else="" class="submission-score-not-graded">NOT GRADED</span>
        </span>
    </t>
</templates>
