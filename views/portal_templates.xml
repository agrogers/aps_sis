<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_parent_children" inherit_id="portal.portal_my_home" name="My Children Portal Entry">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="parent_child_count">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">My Children</t>
                    <t t-set="url" t-value="'/my/children'"/>
                    <t t-set="text">View your children's learning progress.</t>
                    <t t-set="placeholder_count" t-value="'parent_child_count'"/>
                </t>
            </t>
        </xpath>
    </template>

    <template id="portal_my_children" name="My Children">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">My Children</t>
            <div class="o_portal_wrap">
                <div class="container py-4">
                    <h1 class="mb-4">My Children</h1>
                    <t t-if="not students">
                        <div class="alert alert-info">No linked student profiles were found.</div>
                    </t>
                    <div t-else="" class="row g-3">
                        <div t-foreach="students" t-as="student" class="col-md-6 col-lg-4">
                            <a class="card h-100 text-decoration-none" t-att-href="'/my/children/%s' % student.id">
                                <div class="card-body">
                                    <h2 class="h5 card-title text-dark mb-0" t-esc="student.partner_id.name"/>
                                    <p class="card-text text-muted mt-2 mb-0">View progress and recent work</p>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_child_progress" name="Child Progress">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title" t-value="student.partner_id.name"/>
            <div class="o_portal_wrap">
                <div class="container py-4">
                    <a href="/my/children" class="btn btn-link px-0 mb-2">← My Children</a>
                    <h1 class="mb-4" t-esc="student.partner_id.name"/>

                    <div class="row g-3 mb-4">
                        <div class="col-6 col-lg">
                            <div class="card h-100"><div class="card-body">
                                <div class="text-muted small">Assigned</div>
                                <div class="fs-3 fw-bold" t-esc="to_submit"/>
                            </div></div>
                        </div>
                        <div class="col-6 col-lg">
                            <div class="card h-100"><div class="card-body">
                                <div class="text-muted small">Submitted</div>
                                <div class="fs-3 fw-bold" t-esc="submitted"/>
                            </div></div>
                        </div>
                        <div class="col-6 col-lg">
                            <div class="card h-100"><div class="card-body">
                                <div class="text-muted small">Completed</div>
                                <div class="fs-3 fw-bold" t-esc="completed"/>
                            </div></div>
                        </div>
                        <div class="col-6 col-lg">
                            <div class="card h-100"><div class="card-body">
                                <div class="text-muted small">Overdue</div>
                                <div class="fs-3 fw-bold text-danger" t-esc="overdue"/>
                            </div></div>
                        </div>
                        <div class="col-6 col-lg">
                            <div class="card h-100"><div class="card-body">
                                <div class="text-muted small">Average score</div>
                                <div class="fs-3 fw-bold">
                                    <t t-if="average_score is not False"><t t-esc="average_score"/>%</t>
                                    <t t-else="">—</t>
                                </div>
                            </div></div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header"><h2 class="h5 mb-0">Progress by subject</h2></div>
                        <div class="card-body">
                            <t t-if="not subject_chart">
                                <p class="text-muted mb-0">There are no scored submissions yet.</p>
                            </t>
                            <div t-else="">
                                <div t-foreach="subject_chart" t-as="result" class="mb-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span t-esc="result['name']"/>
                                        <span><t t-esc="result['average']"/>% <small class="text-muted">(<t t-esc="result['count']"/> scored)</small></span>
                                    </div>
                                    <div class="progress" role="progressbar"
                                         t-att-aria-valuenow="result['average']" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" t-att-style="'width: %s%%' % result['average']"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header"><h2 class="h5 mb-0">Recent work</h2></div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead><tr>
                                    <th>Work</th><th>Status</th><th>Due date</th><th>Score</th>
                                </tr></thead>
                                <tbody>
                                    <tr t-if="not recent_submissions">
                                        <td colspan="4" class="text-muted text-center py-4">No work to show.</td>
                                    </tr>
                                    <tr t-foreach="recent_submissions" t-as="submission">
                                        <td t-esc="submission.resource_id.display_name"/>
                                        <td t-esc="submission.state.title()"/>
                                        <td t-esc="submission.date_due and submission.date_due.strftime('%d/%m/%Y') or '—'"/>
                                        <td>
                                            <t t-if="submission.score != -0.01 and submission.out_of_marks > 0">
                                                <t t-esc="submission.score"/>/<t t-esc="submission.out_of_marks"/>
                                            </t>
                                            <t t-else="">—</t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_submissions" name="My Submissions">
        <t t-call="web.layout">
            <div class="container o_my_submissions mt-5">
                <div class="row">
                    <div class="col-12">
                        <h1>My Submissions</h1>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <t t-if="not submissions">
                            <p>You have no submissions.</p>
                        </t>
                        <t t-else="">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Task</th>
                                        <th>State</th>
                                        <th>Due Date</th>
                                        <th>Score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="submissions" t-as="submission">
                                        <td><t t-out="submission.task_id.name"/></td>
                                        <td><t t-out="submission.state"/></td>
                                        <td><t t-out="submission.date_due and submission.date_due.strftime('%d/%m/%Y') or '-'"/></td>
                                        <td><t t-out="submission.score != -0.01 and f'{submission.score}/{submission.out_of_marks}' or '-'"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="resource_share_page" name="Resource Share Page">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title" t-value="resource.name or resource.display_name"/>
            <!-- Inject KaTeX CSS into the page <head> -->
            <t t-set="head">
                <link rel="stylesheet" t-att-href="'/aps_sis/static/src/lib/katex/katex.min.css'"/>
            </t>
            <div class="o_portal_wrap">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-lg-9 col-xl-8">

                            <!-- Title card -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-body p-4">
                                    <h1 class="aps-share-h1 mb-1 fw-bold" t-esc="resource.name or resource.display_name"/>
                                    <t t-if="resource.display_name and resource.name and resource.display_name != resource.name">
                                        <p class="text-muted small mb-0" t-esc="resource.display_name"/>
                                    </t>
                                    <t t-if="resource.subjects">
                                        <div class="mt-3">
                                            <t t-foreach="resource.subjects" t-as="subject">
                                                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 me-1 mb-1 px-3 py-2 aps-subject-badge"
                                                      t-esc="subject.name"/>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Notes card -->
                            <t t-if="resource.has_notes in ('yes', 'use_parent') and resource.notes">
                                <div class="card shadow-sm mb-4">
                                    <div class="card-header bg-light py-2 px-4">
                                        <h5 class="mb-0 aps-card-header-title">Notes</h5>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="aps-notes-content" id="aps-notes-content" t-out="notes_html"/>
                                    </div>
                                </div>
                            </t>

                            <!-- Empty state -->
                            <t t-if="resource.has_notes not in ('yes', 'use_parent') and not resource.subjects">
                                <div class="alert alert-light text-muted text-center py-4">
                                    No additional details are available for this resource.
                                </div>
                            </t>

                            <p class="text-center text-muted small mt-4">Shared via APEX</p>

                        </div>
                    </div>
                </div>
            </div>

            <!-- KaTeX JS (loaded at end of body for performance) -->
            <script t-att-src="'/aps_sis/static/src/lib/katex/katex.min.js'"><!-- --></script>
            <script t-att-src="'/aps_sis/static/src/lib/katex/auto-render.min.js'"><!-- --></script>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var el = document.getElementById('aps-notes-content');
                    if (el &amp;&amp; window.renderMathInElement) {
                        renderMathInElement(el, {
                            delimiters: [
                                { left: '$$', right: '$$', display: true },
                                { left: '$',  right: '$',  display: false },
                                { left: '\\(', right: '\\)', display: false },
                                { left: '\\[', right: '\\]', display: true }
                            ],
                            throwOnError: false
                        });
                    }
                });
            </script>

            <style>
                /* ── Heading scale (notes are often authored with large headings) ── */
                .aps-share-h1 { font-size: 1.6rem; }
                .aps-notes-content h1 { font-size: 1.4rem; }
                .aps-notes-content h2 { font-size: 1.25rem; }
                .aps-notes-content h3 { font-size: 1.1rem; }
                .aps-notes-content h4,
                .aps-notes-content h5,
                .aps-notes-content h6 { font-size: 1rem; }

                /* ── Subjects ── */
                .aps-subject-badge { font-size: 0.85rem; }

                /* ── Card section labels ── */
                .aps-card-header-title { font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
                                         letter-spacing: 0.08em; color: #6c757d; }

                /* ── Notes content general ── */
                .aps-notes-content img  { max-width: 100%; height: auto; }
                .aps-notes-content table { width: 100%; border-collapse: collapse; }
                .aps-notes-content table td,
                .aps-notes-content table th { border: 1px solid #dee2e6; padding: 0.4rem 0.6rem; }

                /* ── Generated TOC ── */
                .aps-share-toc-list a { text-decoration: none; color: #495057; font-size: 0.9rem; }
                .aps-share-toc-list a:hover { color: #0d6efd; text-decoration: underline; }
                .aps-share-toc-list li { padding-top: 2px; padding-bottom: 2px; }

                /* ── KaTeX display math ── */
                .aps-notes-content .katex-display { overflow-x: auto; overflow-y: hidden; }
            </style>
        </t>
    </template>
</odoo>
