<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aps_exam_paper_import_list" model="ir.ui.view">
        <field name="name">aps.exam.paper.import.list</field>
        <field name="model">aps.exam.paper.import</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="name"/>
                <field name="resource_id"/>
                <field name="state" widget="badge"/>
                <field name="progress" widget="progressbar"/>
                <field name="section_count"/>
                <field name="warning_count"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_aps_exam_paper_import_form" model="ir.ui.view">
        <field name="name">aps.exam.paper.import.form</field>
        <field name="model">aps.exam.paper.import</field>
        <field name="arch" type="xml">
            <form string="IGCSE Exam Paper Import">
                <header>
                    <button name="action_render_pages" type="object" string="Render Pages" class="btn-primary" invisible="state not in ['uploaded', 'review', 'failed']"/>
                    <button name="action_analyse_pages_with_ai" type="object" string="Analyse Pages" class="btn-primary" invisible="not ai_model_id or state not in ['uploaded', 'review']"/>
                    <button name="action_validate" type="object" string="Validate" invisible="state != 'review'"/>
                    <button name="action_build_resources" type="object" string="Build Resources" class="btn-primary" invisible="state != 'review'"/>
                    <button name="action_retry" type="object" string="Retry" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,uploaded,analysing,review,building,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="resource_id" readonly="1"/>
                            <field name="progress" widget="progressbar" readonly="1"/>
                            <field name="render_dpi"/>
                        </group>
                        <group>
                            <field name="question_attachment_id" readonly="1"/>
                            <field name="mark_scheme_attachment_id" readonly="1"/>
                            <field name="ai_model_id" options="{'no_create': True}"/>
                            <field name="ai_prompt_version" readonly="1"/>
                            <field name="section_count" readonly="1"/>
                            <field name="warning_count" readonly="1"/>
                            <field name="page_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="error_message" readonly="1" invisible="not error_message"/>
                    <notebook>
                        <page string="Detected Sections">
                            <field name="section_ids">
                                <list editable="bottom" default_order="sequence,source_key">
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_label"/>
                                    <field name="source_key" readonly="1"/>
                                    <field name="maximum_mark"/>
                                    <field name="question_summary"/>
                                    <field name="match_confidence"/>
                                    <field name="review_warning"/>
                                    <field name="question_text" optional="hide"/>
                                    <field name="mark_scheme_text" optional="hide"/>
                                    <field name="question_pages" optional="hide"/>
                                    <field name="question_regions" optional="hide"/>
                                    <field name="answer_pages" optional="hide"/>
                                    <field name="answer_regions" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Extracted Text">
                            <group>
                                <field name="question_text" readonly="1"/>
                                <field name="mark_scheme_text" readonly="1"/>
                            </group>
                        </page>
                        <page string="Rendered Pages">
                            <field name="page_ids">
                                <list default_order="document_type,page_number">
                                    <field name="document_type"/>
                                    <field name="page_number"/>
                                    <field name="render_dpi"/>
                                    <field name="width" optional="hide"/>
                                    <field name="height" optional="hide"/>
                                    <field name="attachment_id"/>
                                    <field name="ai_state"/>
                                    <button name="action_view_page" type="object" string="View" icon="fa-eye" class="btn-link"/>
                                    <button name="action_view_analysis" type="object" string="View Result" icon="fa-list-alt" class="btn-link" invisible="ai_state != 'complete'"/>
                                    <button name="action_analyse_page_with_ai" type="object" string="Analysis" icon="fa-magic" class="btn-link" invisible="not parent.ai_model_id "/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_aps_exam_paper_page_form" model="ir.ui.view">
        <field name="name">aps.exam.paper.page.form</field>
        <field name="model">aps.exam.paper.page</field>
        <field name="arch" type="xml">
            <form string="Rendered Page Analysis">
                <sheet>
                    <group>
                        <field name="import_id" readonly="1"/>
                        <field name="document_type" readonly="1"/>
                        <field name="page_number" readonly="1"/>
                        <field name="attachment_id" readonly="1"/>
                        <field name="ai_state" readonly="1"/>
                        <field name="ai_call_log_id" readonly="1"/>
                    </group>
                    <field name="error_message" readonly="1" invisible="not error_message"/>
                    <field name="ai_response" readonly="1" widget="json"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aps_exam_paper_import" model="ir.actions.act_window">
        <field name="name">Exam Paper Imports</field>
        <field name="res_model">aps.exam.paper.import</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>