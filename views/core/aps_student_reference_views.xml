<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aps_student_enrolment_status_view_list" model="ir.ui.view">
        <field name="name">aps.student.enrolment.status.list</field>
        <field name="model">aps.student.enrolment.status</field>
        <field name="arch" type="xml">
            <list default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="icon" widget="image" options="{'size': [32, 32]}"/>
                <field name="description" optional="hide"/>
                <field name="color" widget="color"/>
            </list>
        </field>
    </record>

    <record id="aps_student_enrolment_status_view_form" model="ir.ui.view">
        <field name="name">aps.student.enrolment.status.form</field>
        <field name="model">aps.student.enrolment.status</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="icon" widget="image" options="{'size': [32, 32]}"/>
                            <field name="color" widget="color"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Describe when this status applies..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="aps_student_enrolment_status_action" model="ir.actions.act_window">
        <field name="name">Student Enrolment Statuses</field>
        <field name="res_model">aps.student.enrolment.status</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="aps_student_leaving_reason_view_list" model="ir.ui.view">
        <field name="name">aps.student.leaving.reason.list</field>
        <field name="model">aps.student.leaving.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="aps_student_leaving_reason_view_form" model="ir.ui.view">
        <field name="name">aps.student.leaving.reason.form</field>
        <field name="model">aps.student.leaving.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="aps_student_leaving_reason_action" model="ir.actions.act_window">
        <field name="name">Student Leaving Reasons</field>
        <field name="res_model">aps.student.leaving.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="aps_student_entry_source_view_list" model="ir.ui.view">
        <field name="name">aps.student.entry.source.list</field>
        <field name="model">aps.student.entry.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="aps_student_entry_source_view_form" model="ir.ui.view">
        <field name="name">aps.student.entry.source.form</field>
        <field name="model">aps.student.entry.source</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="aps_student_entry_source_action" model="ir.actions.act_window">
        <field name="name">Student Entry Sources</field>
        <field name="res_model">aps.student.entry.source</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>