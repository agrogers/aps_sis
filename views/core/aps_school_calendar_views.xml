<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="aps_school_calendar_view_list" model="ir.ui.view">
        <field name="name">aps.school.calendar.list</field>
        <field name="model">aps.school.calendar</field>
        <field name="arch" type="xml">
            <list default_order="date">
                <field name="date"/>
                <field name="date_type_id"
                       decoration-danger="date_type_id.code == 'public_holiday'"
                       decoration-warning="date_type_id.code == 'school_holiday'"
                       decoration-info="date_type_id.code == 'student_free'"
                       decoration-muted="date_type_id.code == 'weekend'"/>
                <field name="description"/>
                <field name="repeating" optional="show"/>
                <field name="applies_to_level_ids" optional="show"/>
                <field name="week_id" optional="show"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="aps_school_calendar_view_form" model="ir.ui.view">
        <field name="name">aps.school.calendar.form</field>
        <field name="model">aps.school.calendar</field>
        <field name="arch" type="xml">
            <form string="School Calendar Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="date_display" readonly="True"/>
                            <field name="date_type_id"/>
                            <field name="applies_to_level_ids"
                                widget="many2many_tags"
                                placeholder="Leave blank for all levels"/>
                        </group>
                        <group>
                            <field name="week_id" readonly="True"/>
                            <field name="description"/>
                            <field name="repeating"/>
                            <field name="icon" widget="image" options="{'size': [24, 24]}" optional="show"/>

                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="aps_school_calendar_view_search" model="ir.ui.view">
        <field name="name">aps.school.calendar.search</field>
        <field name="model">aps.school.calendar</field>
        <field name="arch" type="xml">
            <search string="School Calendar">
                <field name="date"/>
                <field name="description"/>
                <field name="applies_to_level_ids"/>
                <field name="week_id"/>
                <filter string="Public Holidays" name="public_holiday"
                        domain="[('date_type_id.code', '=', 'public_holiday')]"/>
                <filter string="School Holidays" name="school_holiday"
                        domain="[('date_type_id.code', '=', 'school_holiday')]"/>
                <filter string="Student Free Days" name="student_free"
                        domain="[('date_type_id.code', '=', 'student_free')]"/>
                <filter string="Weekends" name="weekend"
                        domain="[('date_type_id.code', '=', 'weekend')]"/>
                <separator/>
                <filter string="Repeats Annually" name="repeating"
                        domain="[('repeating', '=', True)]"/>
                <separator/>
                <filter string="All Levels" name="all_levels"
                        domain="[('applies_to_level_ids', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'date_type_id'}"/>
                    <filter string="Level" name="group_level" context="{'group_by': 'applies_to_level_ids'}"/>
                    <filter string="Week" name="group_week" context="{'group_by': 'week_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="aps_school_calendar_view_calendar" model="ir.ui.view">
        <field name="name">aps.school.calendar.calendar</field>
        <field name="model">aps.school.calendar</field>
        <field name="arch" type="xml">
            <calendar string="School Calendar"
                      date_start="date"
                      color="color"
                      mode="month"
                      quick_create="false">
                <field name="date_type_id"/>
                <field name="description"/>
                <field name="applies_to_level_ids"/>
            </calendar>
        </field>
    </record>

    <!-- Window Action -->
    <record id="aps_school_calendar_action" model="ir.actions.act_window">
        <field name="name">School Calendar</field>
        <field name="res_model">aps.school.calendar</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="aps_school_calendar_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first school calendar entry.
            </p>
        </field>
    </record>

    <!-- Date Type management -->
    <record id="aps_calendar_date_type_view_list" model="ir.ui.view">
        <field name="name">aps.calendar.date.type.list</field>
        <field name="model">aps.calendar.date.type</field>
        <field name="arch" type="xml">
            <list editable="bottom" open_form_view="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="icon" widget="image" optional="hide"/>
                <field name="print_color" widget="color"/>
                <field name="color" widget="color" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="aps_calendar_date_type_view_form" model="ir.ui.view">
        <field name="name">aps.calendar.date.type.form</field>
        <field name="model">aps.calendar.date.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="icon" widget="image" options="{'size': [64, 64]}"/>
                        <field name="print_color" widget="color"/>
                        <field name="color" widget="color"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="aps_calendar_date_type_action" model="ir.actions.act_window">
        <field name="name">Calendar Date Types</field>
        <field name="res_model">aps.calendar.date.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="aps_calendar_date_type_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="aps_calendar_date_type_view_list"/>
        <field name="act_window_id" ref="aps_calendar_date_type_action"/>
    </record>

    <record id="aps_calendar_date_type_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="aps_calendar_date_type_view_form"/>
        <field name="act_window_id" ref="aps_calendar_date_type_action"/>
    </record>

</odoo>
