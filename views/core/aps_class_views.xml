<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="aps_class_view_list" model="ir.ui.view">
        <field name="name">aps.class.list</field>
        <field name="model">aps.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="subject_id" optional="show"/>
                <field name="academic_year_id" optional="show"/>
                <field name="enrollment_count"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="aps_class_view_form" model="ir.ui.view">
        <field name="name">aps.class.form</field>
        <field name="model">aps.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <div class="alert alert-info" role="alert">
                    <strong>Classes</strong> are a specific section or group for a <strong>Subject</strong> in a given <strong>Academic Year</strong>
                    (e.g. Mathematics A, Year 1). The identifier (e.g. A, B, 1) combines with the subject to auto-generate the class name and code.
                    Assign <strong>Teachers</strong> and enrol <strong>Students</strong> below.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_enrollments" type="object" class="oe_stat_button"
                                icon="fa-users">
                            <field name="enrollment_count" widget="statinfo" string="Students"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Class Name"/>
                        </h1>
                        <h2>
                            <field name="code" placeholder="Code"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="identifier"/>
                            <field name="subject_id"/>
                            <field name="academic_year_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Teachers">
                            <field name="teacher_ids" widget="many2many_tags"
                                options="{'no_create': True}" nolabel="1"/>
                        </group>
                        <group string="Assistant Teachers">
                            <field name="assistant_teacher_ids" widget="many2many_tags"
                                options="{'no_create': True}" nolabel="1"/>
                        </group>
                        <group string="Tags">
                            <field name="tag_ids" widget="many2many_tags" nolabel="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students">
                            <field name="enrollment_ids">
                                <list>
                                    <field name="student_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="state" widget="badge"
                                        decoration-success="state == 'enrolled'"
                                        decoration-warning="state == 'withdrawn'"
                                        decoration-muted="state == 'finished'"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Maintain">
                            <group>
                                <group>
                                    <field name="copy_from_aca_year_id"
                                           options="{'no_create': True}"/>
                                    <field name="copy_students_from_class_id"
                                           domain="[('id', '!=', id), ('academic_year_id', '=?', copy_from_aca_year_id)]"
                                           options="{'no_create': True}"/>
                                    <field name="copy_students_preview_ids"
                                           widget="many2many_tags"
                                           readonly="1"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <button name="action_copy_students"
                                            type="object"
                                            string="Copy Students"
                                            class="btn-primary"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="aps_class_view_search" model="ir.ui.view">
        <field name="name">aps.class.search</field>
        <field name="model">aps.class</field>
        <field name="arch" type="xml">
            <search string="Classes">
                <field name="name"/>
                <field name="code"/>
                <field name="identifier"/>
                <field name="subject_id"/>
                <field name="academic_year_id"/>
                <field name="tag_ids"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Current Academic Year"
                        name="current_academic_year"
                        domain="[('academic_year_id.is_current', '=', True)]"/>
                <filter string="Has Students"
                        name="has_students"
                        domain="[('enrollment_ids', '!=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Subject" name="group_subject" context="{'group_by': 'subject_id'}"/>
                    <filter string="Academic Year" name="group_year" context="{'group_by': 'academic_year_id'}"/>
                </group>
                <searchpanel>
                    <field name="subject_id" string="Subjects" icon="fa-book"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="aps_class_action" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">aps.class</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="aps_class_view_search"/>
        <field name="path">apex-classes</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first class.
            </p>
        </field>
    </record>

</odoo>
