<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="aps_team_view_list" model="ir.ui.view">
        <field name="name">aps.team.list</field>
        <field name="model">aps.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color" widget="color"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"/>
                <field name="captain_student_ids" widget="many2many_tags" optional="hide"/>
                <field name="captain_staff_ids" widget="many2many_tags" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="aps_team_view_form" model="ir.ui.view">
        <field name="name">aps.team.form</field>
        <field name="model">aps.team</field>
        <field name="arch" type="xml">
            <form string="Team">
                <div class="alert alert-info" role="alert">
                    <strong>Teams</strong> are groups of students and staff used for team-based scoring and competitions.
                    Assign captains to manage team activities and track points through the Team Points model.
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Team Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" widget="color"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="icon" widget="image"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Student Captains">
                            <field name="captain_student_ids" nolabel="1" widget="many2many_tags"/>
                        </page>
                        <page string="Staff Captains">
                            <field name="captain_staff_ids" nolabel="1" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="aps_team_view_search" model="ir.ui.view">
        <field name="name">aps.team.search</field>
        <field name="model">aps.team</field>
        <field name="arch" type="xml">
            <search string="Teams">
                <field name="name"/>
                <field name="tag_ids"/>
                <field name="captain_student_ids"/>
                <field name="captain_staff_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="aps_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">aps.team</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="aps_team_view_search"/>
        <field name="path">apex-teams</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first team to start tracking team-based scoring.
            </p>
        </field>
    </record>

</odoo>