<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="aps_teacher_view_list" model="ir.ui.view">
        <field name="name">aps.teacher.list</field>
        <field name="model">aps.teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="image_128" widget="image" class="o_image_24_max" optional="show"/>
                <field name="name"/>
                <field name="tutor_code" optional="show"/>
                <field name="teaching_load" optional="show"/>
                <field name="teaching_load_percentage" widget="percentpie_ranged" string="Teaching %"
                       options="{'sentinel': -0.01}" optional="show"/>
                <field name="non_teaching_load" optional="show"/>
                <field name="non_teaching_load_percentage" widget="percentpie_ranged" string="Non-Teaching %"
                       options="{'sentinel': -0.01}" optional="show"/>
                <field name="max_load" optional="show"/>
                <field name="max_non_teaching_load" optional="show"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="partner_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="aps_teacher_view_kanban" model="ir.ui.view">
        <field name="name">aps.teacher.kanban</field>
        <field name="model">aps.teacher</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_order="name">
                <field name="id"/>
                <field name="name"/>
                <field name="tutor_code"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="image_128"/>
                <template>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-2">
                            <field name="image_128" widget="image" class="o_image_64_max rounded-circle flex-shrink-0"/>
                            <div class="flex-grow-1 min-w-0">
                                <strong class="d-block text-truncate">
                                    <field name="name"/>
                                </strong>
                                <span t-if="record.tutor_code.value" class="badge text-bg-secondary me-1">
                                    <t t-esc="record.tutor_code.value"/>
                                </span>
                                <div t-if="record.email.value" class="text-muted small text-truncate">
                                    <i class="fa fa-envelope me-1"/>
                                    <t t-esc="record.email.value"/>
                                </div>
                                <div t-if="record.phone.value" class="text-muted small">
                                    <i class="fa fa-phone me-1"/>
                                    <t t-esc="record.phone.value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </template>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="aps_teacher_view_form" model="ir.ui.view">
        <field name="name">aps.teacher.form</field>
        <field name="model">aps.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <div class="alert alert-info" role="alert">
                    <strong>Teachers</strong> are linked to a <strong>Contact</strong>. When the
                    <em>Is Teacher</em> flag is set on a contact, a teacher record is automatically
                    created here. Use the <strong>Tutor Code</strong> to assign a short identifier
                    for scheduling and reporting purposes.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_classes" type="object" class="oe_stat_button"
                                icon="fa-users">
                            <field name="class_count" widget="statinfo" string="Classes"/>
                        </button>
                    </div>
                    <field name="image_128" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="tutor_code"/>
                        </group>
                        <group>
                            <field name="email" readonly="1"/>
                            <field name="phone" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Workload">
                            <group string="Workload Allocation" col="8">
                                <group string="Teaching" col="8" colspan="8">
                                    <field name="teaching_load" string="Load" readonly="1"/>
                                    <field name="teaching_load_percentage" string="%" widget="percentpie_ranged"
                                           options="{'sentinel': -0.01}" readonly="1"/>
                                    <field name="max_load" string="Max"/>
                                    <field name="teaching_load_fte" string="FTE"/>
                                    <div class="text-muted" colspan="8">
                                        Load amounts are calculated from the timetable.
                                    </div>
                                </group>
                                <group string="Non-Teaching" col="8" colspan="8">
                                    <field name="non_teaching_load" string="Load" readonly="1"/>
                                    <field name="non_teaching_load_percentage" string="%" widget="percentpie_ranged"
                                           options="{'sentinel': -0.01}" readonly="1"/>
                                    <field name="max_non_teaching_load" string="Max"/>
                                    <field name="non_teaching_load_fte" string="FTE"/>
                                </group>
                            </group>
                            <group string="Roles" groups="hr.group_hr_user">
                                <group string="Role 1" invisible="not role_job1_id">
                                    <field name="role_job1_id" string="Job 1"/>
                                    <field name="role_fte1" string="FTE 1"/>
                                    <field name="role_department1_id" string="Department 1"/>
                                </group>
                                <group string="Role 2" invisible="not role_job2_id">
                                    <field name="role_job2_id" string="Job 2"/>
                                    <field name="role_fte2" string="FTE 2"/>
                                    <field name="role_department2_id" string="Department 2"/>
                                </group>
                                <group string="Role 3" invisible="not role_job3_id">
                                    <field name="role_job3_id" string="Job 3"/>
                                    <field name="role_fte3" string="FTE 3"/>
                                    <field name="role_department3_id" string="Department 3"/>
                                </group>
                            </group>
                            <div class="mb-3">
                                <button name="action_recompute_timetable_loads" type="object"
                                        string="Refresh from Timetable" icon="fa-refresh"
                                        class="btn btn-secondary"/>
                                <button name="action_open_workload_profile" type="object"
                                    string="Workload Profile" icon="fa-bar-chart"
                                    class="btn btn-primary ms-2"/>
                            </div>
                            <group string="Load Details">
                                <field name="load_details" widget="html" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Classes">
                            <field name="class_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="subject_id"/>
                                    <field name="academic_year_id"/>
                                    <field name="enrollment_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="aps_teacher_view_pivot" model="ir.ui.view">
        <field name="name">aps.teacher.pivot</field>
        <field name="model">aps.teacher</field>
        <field name="arch" type="xml">
            <pivot string="Teacher Workload">
                <field name="name" type="row"/>
                <field name="teaching_load" type="measure"/>
                <field name="non_teaching_load" type="measure"/>
                <field name="max_load" type="measure"/>
                <field name="max_non_teaching_load" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Chart View -->
    <record id="aps_teacher_view_graph" model="ir.ui.view">
        <field name="name">aps.teacher.graph</field>
        <field name="model">aps.teacher</field>
        <field name="arch" type="xml">
            <graph string="Teacher Workload" type="bar">
                <field name="name" type="row"/>
                <field name="teaching_load" type="measure"/>
                <field name="non_teaching_load" type="measure"/>
                <field name="max_load" type="measure"/>
                <field name="max_non_teaching_load" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="aps_teacher_view_search" model="ir.ui.view">
        <field name="name">aps.teacher.search</field>
        <field name="model">aps.teacher</field>
        <field name="arch" type="xml">
            <search string="Teachers">
                <field name="name"/>
                <field name="tutor_code"/>
                <field name="email"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Populate server action (shows in Actions menu) -->
    <record id="aps_teacher_action_populate" model="ir.actions.server">
        <field name="path">apex-aps-teacher-action-populate</field>
        <field name="name">Populate from Contacts</field>
        <field name="model_id" ref="model_aps_teacher"/>
        <field name="binding_model_id" ref="model_aps_teacher"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = model.action_populate_from_contacts()</field>
    </record>

    <!-- Window Action -->
    <record id="aps_teacher_action" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">aps.teacher</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="aps_teacher_view_search"/>
        <field name="path">apex-teachers</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No teachers yet. Tick <b>Is Teacher</b> on a contact, or use
                <b>Actions → Populate from Contacts</b> to import all flagged contacts.
            </p>
        </field>
    </record>

    <record id="aps_teacher_action_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="aps_teacher_view_kanban"/>
        <field name="act_window_id" ref="aps_teacher_action"/>
    </record>

    <record id="aps_teacher_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="aps_teacher_view_list"/>
        <field name="act_window_id" ref="aps_teacher_action"/>
    </record>

    <record id="aps_teacher_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="aps_teacher_view_form"/>
        <field name="act_window_id" ref="aps_teacher_action"/>
    </record>

    <record id="aps_teacher_action_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="aps_teacher_view_pivot"/>
        <field name="act_window_id" ref="aps_teacher_action"/>
    </record>

    <record id="aps_teacher_action_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="5"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="aps_teacher_view_graph"/>
        <field name="act_window_id" ref="aps_teacher_action"/>
    </record>

</odoo>
