<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Paper format: A4 portrait, tight margins, no header -->
        <record id="paperformat_school_calendar" model="report.paperformat">
            <field name="name">School Calendar Format</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">8</field>
            <field name="margin_bottom">8</field>
            <field name="margin_left">8</field>
            <field name="margin_right">8</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
        </record>

        <!-- Report action (invoked from the HTML preview Print button) -->
        <record id="school_calendar_report_action" model="ir.actions.report">
            <field name="name">Academic Calendar</field>
            <field name="model">aps.school.calendar</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">aps_sis.report_school_calendar_template</field>
            <field name="print_report_name">'Academic Calendar'</field>
            <field name="binding_model_id" eval="False"/>
            <field name="paperformat_id" ref="aps_sis.paperformat_school_calendar"/>
        </record>

        <!-- Report template -->
        <template id="report_school_calendar_template">
            <t t-call="web.basic_layout">
                <t t-set="doc"
                   t-value="env['aps.academic.year'].browse(data.get('academic_year_id') or docs and docs[0].id) if data else env['aps.academic.year'].search([('is_current', '=', True)], limit=1)"/>

                <div class="scr-pdf">
                    <style>
                        .scr-pdf { font-family: Arial, Helvetica, sans-serif; }
                        .scr-pdf table { border-collapse: collapse; width: 100%; table-layout: fixed; }
                        .scr-header td { padding-bottom: 2mm; }
                        .scr-logo-cell { width: 20mm; }
                        .scr-logo-cell img { max-height: 9mm; max-width: 19mm; }
                        .scr-title-cell {
                            color: #1760C8; font-weight: bold; font-size: 20pt;
                            text-align: center;
                        }
                        .scr-rule-cell { border-top: 2px solid #E53935; }
                        .scr-events-cell { width: 22%; vertical-align: middle; padding: 0 4px; }
                        .scr-month-cell { width: 28%; vertical-align: top; padding: 0 4px; }
                        .scr-event-list { font-size: 7pt; }
                        .scr-ev-dates { font-weight: bold; text-align: right; padding-right: 5px; white-space: nowrap; }
                        .scr-ev-badge {
                            display: inline-block; min-width: 4mm; line-height: 3.6mm;
                            padding: 0 1mm; border-radius: 1mm;
                            background-color: #A5D6A7; color: white;
                            font-size: 6.5pt; text-align: center;
                        }
                        .scr-ev-badge.scr-badge-light { color: #000; }
                        .scr-ev-title { text-align: left; }
                        .scr-month-title {
                            background-color: #9565E8; color: white; font-weight: bold;
                            text-align: center; font-size: 9pt; padding: 1px 0;
                        }
                        .scr-grid th, .scr-grid td {
                            border: 1px solid #222; text-align: center;
                            vertical-align: middle; height: 5.5mm; font-size: 7.5pt;
                        }
                        .scr-weekdays th { background-color: #B8CBE8; font-weight: bold; height: 5mm; }
                        .scr-sem-wrap { width: 100%; border-collapse: collapse; margin-bottom: 3mm; }
                        .scr-sem-cell { width: 33%; padding: 0 2mm; vertical-align: top; }
                        .scr-sem-table { width: 100%; border-collapse: collapse; font-size: 8pt; }
                        .scr-sem-table th, .scr-sem-table td {
                            border: 1px solid #222; text-align: center; padding: 1px 4px;
                        }
                        .scr-sem-table .scr-sem-head th { background-color: #9565E8; color: white; font-weight: bold; }
                        .scr-sem-table .scr-sem-sub th { background-color: #B8CBE8; font-weight: bold; }
                        .scr-sem-note { font-size: 8pt; font-style: italic; text-align: center; padding: 1mm; }
                        .scr-sem-legend-cell { padding: 2mm 1mm 0; text-align: center; }
                        .scr-sem-legend-title { font-size: 8pt; font-weight: bold; margin-bottom: 1mm; }
                        .scr-sem-legend-item { display: inline-block; font-size: 7pt; margin: 0 2mm 1mm 0; }
                        .scr-sem-legend-swatch { display: inline-block; width: 3mm; height: 3mm; border: 1px solid #777; vertical-align: middle; margin-right: 1mm; }
                    </style>

                    <!-- Header -->
                    <table class="scr-header">
                        <tr>
                            <td class="scr-logo-cell">
                                <img t-if="env.company.logo"
                                     t-att-src="'/logo.png?company=%s' % env.company.id"
                                     alt="Logo"/>
                            </td>
                            <td class="scr-title-cell">
                                <t t-esc="doc.short_name or doc.name"/> ACADEMIC CALENDAR
                            </td>
                            <td class="scr-logo-cell"/>
                        </tr>
                        <tr><td colspan="3" class="scr-rule-cell"/></tr>
                    </table>

                    <!-- Semester summary -->
                    <t t-set="sections"
                       t-value="env['aps.school.calendar'].get_term_summary_data(doc.start_date, doc.end_date)"/>
                    <t t-if="sections">
                        <table class="scr-sem-wrap">
                            <tr>
                                <t t-foreach="sections" t-as="sem">
                                    <td class="scr-sem-cell">
                                        <table class="scr-sem-table">
                                            <tr class="scr-sem-head">
                                                <th t-att-colspan="sem.get('terms') and 4 or 2" t-esc="sem['name']"/>
                                            </tr>
                                            <tr class="scr-sem-sub">
                                                <t t-if="sem.get('terms')">
                                                    <th>Term</th><th>Weeks</th><th>Days</th><th>Dates</th>
                                                </t>
                                                <t t-else="">
                                                    <th>Weeks</th><th>Days</th>
                                                </t>
                                            </tr>
                                            <t t-if="sem.get('terms')">
                                                <tr t-foreach="sem['terms']" t-as="row">
                                                    <td t-esc="row['term']"/>
                                                    <td t-esc="row['weeks']"/>
                                                    <td t-esc="row['days']"/>
                                                    <td t-esc="row['dates']"/>
                                                </tr>
                                            </t>
                                            <t t-else="">
                                                <tr>
                                                    <td t-esc="sem['weeks']"/>
                                                    <td t-esc="sem['days']"/>
                                                </tr>
                                                <tr>
                                                    <td colspan="2" class="scr-sem-note">Calendar is subject to change.</td>
                                                </tr>
                                            </t>
                                        </table>
                                    </td>
                                </t>
                            </tr>
                            <tr>
                                <td colspan="100" class="scr-sem-legend-cell">
                                    <div class="scr-sem-legend-title">Day Types</div>
                                    <t t-foreach="sections[2].get('legend', [])" t-as="item">
                                        <span class="scr-sem-legend-item">
                                            <span class="scr-sem-legend-swatch" t-att-style="'background-color:' + item['color']"/>
                                            <span t-esc="item['name']"/>
                                        </span>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </t>

                    <!-- Month rows -->
                    <t t-set="months"
                       t-value="env['aps.school.calendar'].get_calendar_report_data(doc.start_date, doc.end_date)"/>
                    <t t-foreach="range(0, len(months), 2)" t-as="i">
                        <table class="scr-row">
                            <tr>
                                <td class="scr-events-cell">
                                    <table class="scr-event-list">
                                        <tr t-foreach="months[i]['events']" t-as="ev">
                                            <td class="scr-ev-entry">
                                                <span class="scr-ev-title" t-esc="ev['title']"/>
                                                <span t-attf-class="scr-ev-badge #{not ev['color'] or ev['color'].upper() == '#FFFFFF' ? 'scr-badge-light' : ''}" t-att-style="'background-color:' + ev['color']" t-esc="ev['dates']"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                                <t t-foreach="[months[i], months[i + 1] if i + 1 &lt; len(months) else None]" t-as="month">
                                    <td class="scr-month-cell">
                                        <t t-if="month">
                                            <div class="scr-month-title" t-esc="month['label']"/>
                                            <table class="scr-grid">
                                                <tr class="scr-weekdays">
                                                    <th>M</th><th>T</th><th>W</th><th>T</th><th>F</th><th><t t-if="any(w['saturday'] for w in month['weeks'])">S</t></th>
                                                </tr>
                                                <t t-foreach="month['weeks']" t-as="week">
                                                    <tr>
                                                        <t t-foreach="week['days']" t-as="cell">
                                                            <td t-att-style="(cell and cell['color'] and cell['color'].upper() != '#FFFFFF') and ('background-color:' + cell['color']) or ((cell and (not cell.get('color') or cell['color'].upper() == '#FFFFFF')) and 'color:#000;') or None">
                                                                <t t-esc="cell['day'] if cell else ''"/>
                                                                <img t-if="cell and cell.get('icon_url')"
                                                                     t-att-src="cell['icon_url']"
                                                                     style="position:absolute;top:0;right:0;height:4mm;width:4mm;object-fit:contain;"/>
                                                            </td>
                                                        </t>                                                        <td t-if="week['saturday']"
                                                            t-att-style="'background-color:' + week['saturday']['color'] + (';color:#000;' if week['saturday']['color'].upper() == '#FFFFFF' else '')"
                                                            t-esc="week['saturday']['day']"/>
                                                        <t t-else="">
                                                            <td style="border:none;"/>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </table>
                                        </t>
                                    </td>
                                </t>
                                <td class="scr-events-cell">
                                    <t t-if="i + 1 &lt; len(months)">
                                        <table class="scr-event-list">
                                            <tr t-foreach="months[i + 1]['events']" t-as="ev">
                                                <td class="scr-ev-entry">
                                                    <span t-attf-class="scr-ev-badge #{not ev['color'] or ev['color'].upper() == '#FFFFFF' ? 'scr-badge-light' : ''}" t-att-style="'background-color:' + ev['color']" t-esc="ev['dates']"/>
                                                    <span class="scr-ev-title" t-esc="ev['title']"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </t>
                                </td>
                            </tr>
                        </table>
                    </t>
                </div>
            </t>
        </template>

    </data>
</odoo>
