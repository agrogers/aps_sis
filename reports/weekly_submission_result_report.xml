<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_weekly_submission_result_landscape" model="report.paperformat">
        <field name="name">Weekly Submission Results A4 Landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
    </record>

    <record id="weekly_submission_result_report_action" model="ir.actions.report">
        <field name="name">Weekly Submission Results</field>
        <field name="model">aps.weekly.submission.result</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">aps_sis.weekly_submission_result_template</field>
        <field name="paperformat_id" ref="aps_sis.paperformat_weekly_submission_result_landscape"/>
        <field name="binding_model_id" ref="aps_sis.model_aps_weekly_submission_result"/>
        <field name="binding_type">report</field>
    </record>

    <template id="weekly_submission_result_template">
        <t t-call="web.basic_layout">
            <div class="page">
                <h2>Weekly Submission Results</h2>
                <p>
                    Student:
                    <strong t-esc="docs[:1].student_id.display_name"/>
                </p>
                <table class="table table-sm table-bordered" style="font-size: 9px;">
                    <thead>
                        <tr>
                            <th>Week</th>
                            <th>Subject</th>
                            <th>Resource Type</th>
                            <th>Submissions</th>
                            <th>Percentage</th>
                            <th>Out Of Marks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="result">
                            <tr>
                                <td><span t-field="result.week_start"/></td>
                                <td><span t-field="result.subject_id"/></td>
                                <td><span t-field="result.type_id"/></td>
                                <td><span t-field="result.submission_count"/></td>
                                <td><span t-field="result.weighted_percent"/>%</td>
                                <td><span t-field="result.out_of_marks_total"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>