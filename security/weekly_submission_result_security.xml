<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_aps_weekly_submission_result_student" model="ir.rule">
        <field name="name">Student: Own Weekly Submission Results</field>
        <field name="model_id" ref="model_aps_weekly_submission_result"/>
        <field name="domain_force">[('student_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_aps_student'))]"/>
    </record>
    <record id="rule_aps_weekly_submission_result_teacher" model="ir.rule">
        <field name="name">Teacher: Weekly Submission Results</field>
        <field name="model_id" ref="model_aps_weekly_submission_result"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_aps_teacher'))]"/>
    </record>
</odoo>
