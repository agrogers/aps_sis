<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ########################################## -->
        <!-- School Management module category -->
        <!-- ########################################## -->
        <record id="module_category_root_school_management" model="ir.module.category">
            <field name="name">APEX School General Permissions</field>
            <field name="sequence">200</field>
        </record>

        <!-- APEX Core: These groups are defined here because Core depends on aps_sis. Don't define them in Core. -->
        
        <record id="module_category_aps_core_in_sis" model="ir.module.category">
            <field name="name">APEX Core</field>
            <field name="parent_id" ref="module_category_root_school_management"/>
            <field name="description">Core tables - subjects, classes, teachers, students etc</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_aps_student_core" model="res.groups">
            <field name="name">Student</field>
            <field name="category_id" ref="module_category_aps_core_in_sis"/>
            <field name="comment">Students can view their own enrolements</field>
        </record>

        <record id="group_aps_staff_core" model="res.groups">
            <field name="name">Staff</field>
            <field name="category_id" ref="module_category_aps_core_in_sis"/>
            <field name="implied_ids" eval="[(4, ref('group_aps_student_core'))]"/>
            <field name="comment">Staff can view calendars, voting etc</field>
        </record>

        <record id="group_aps_teacher_core" model="res.groups">
            <field name="name">Teacher</field>
            <field name="category_id" ref="module_category_aps_core_in_sis"/>
            <field name="implied_ids" eval="[(4, ref('group_aps_staff_core'))]"/>
            <field name="comment">Teachers can access classes, subjects, timetables etc</field>
        </record>

        <record id="group_aps_manager_core" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_aps_core_in_sis"/>
            <field name="implied_ids" eval="[(4, ref('group_aps_teacher_core'))]"/>
            <field name="comment">Manager access to all APEX core features</field>
        </record>
        <record id="group_aps_administrator_core" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_aps_core_in_sis"/>
            <field name="implied_ids" eval="[(4, ref('group_aps_manager_core'))]"/>
            <field name="comment">Full administrative access to all APEX core features</field>
        </record>


        <!-- APS LMS  -->

        <record id="module_category_aps_lms" model="ir.module.category">
            <field name="name">APEX LMS</field>
            <field name="parent_id" ref="module_category_root_school_management"/>
            <field name="description">Academic Progress and Excellence – resource assignment, submissions, and grading.</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_awards_user" model="res.groups">
            <field name="name">Awards User</field>
            <field name="category_id" ref="module_category_awards"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can access the awards voting dashboard.</field>
        </record>

        <record id="group_awards_manager" model="res.groups">
            <field name="name">Awards Manager</field>
            <field name="category_id" ref="module_category_awards"/>
            <field name="implied_ids" eval="[(4, ref('group_awards_user'))]"/>
            <field name="comment">Manages award voting, certificates, and award configuration.</field>
        </record>

        <record id="group_awards_administrator" model="res.groups">
            <field name="name">Awards Administrator</field>
            <field name="category_id" ref="module_category_awards"/>
            <field name="implied_ids" eval="[(4, ref('group_awards_manager'))]"/>
            <field name="comment">Full administrative access to Awards.</field>
        </record>

        <!-- APS SIS Security Groups (hierarchy: Student → Teacher → Manager)
             A clean linear inheritance chain is what makes Odoo render these
             as a dropdown instead of checkboxes in user settings. -->

        <record id="group_aps_student" model="res.groups">
            <field name="name">Student</field>
            <field name="category_id" ref="module_category_aps_lms"/>
            <field name="comment">Students can view their assigned resources and submit attempts</field>
        </record>

        <record id="group_aps_teacher" model="res.groups">
            <field name="name">Teacher</field>
            <field name="category_id" ref="module_category_aps_lms"/>
            <field name="implied_ids" eval="[(4, ref('group_aps_student'))]"/>
            <field name="comment">Teachers can manage resources, tasks, and view student progress</field>
        </record>

        <record id="group_aps_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_aps_lms"/>
            <field name="implied_ids" eval="[(4, ref('group_aps_teacher')), (4, ref('group_awards_manager'))]"/>
            <field name="comment">Full administrative access to all APEX features</field>
        </record>


        <record id="module_category_awards" model="ir.module.category">
            <field name="name">Awards</field>
            <field name="parent_id" ref="module_category_root_school_management"/>
            <field name="description">Award voting, certificates, and award administration.</field>
            <field name="sequence">30</field>
        </record>

        <record id="module_category_school_calendar" model="ir.module.category">
            <field name="name">School Calendar</field>
            <field name="parent_id" ref="module_category_root_school_management"/>
            <field name="sequence">25</field>
        </record>

        <record id="group_school_calendar_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field name="category_id" ref="module_category_school_calendar"/>
            <field name="comment">Can view the school calendar.</field>
        </record>

        <record id="group_school_calendar_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_school_calendar"/>
            <field name="implied_ids" eval="[(4, ref('group_school_calendar_viewer'))]"/>
            <field name="comment">Can manage the school calendar.</field>
        </record>

        <!-- ########################################## -->
        <!-- APS SPECIAL PERMISSIONS (checkboxes)  -->
        <!-- ########################################## -->

        <record id="module_category_root_school_management_special" model="ir.module.category">
            <field name="name">APEX School Special Permissions</field>
            <field name="sequence">1</field>
        </record>

        <!-- Voting Token Access — in a separate category (not module_category_aps)
             so it doesn't break the Student→Teacher→Manager linear chain. -->
        <record id="group_aps_voting_token_access" model="res.groups">
            <field name="name">Voting Token Access</field>
            <field name="category_id" ref="module_category_root_school_management_special"/>
            <field name="comment">Can view and reset voting access tokens from the secured partner popup.</field>
        </record>

        <record id="group_dashboard_awards" model="res.groups">
            <field name="name">Awards</field>
            <field name="category_id" ref="module_category_root_school_management_special"/>
        </record>
        <record id="group_dashboard_attendance" model="res.groups">
            <field name="name">View Attendance Roll</field>
            <field name="category_id" ref="module_category_root_school_management_special"/>
        </record>
        <record id="group_dashboard_attendance_manage" model="res.groups">
            <field name="name">Manage Attendance Roll</field>
            <field name="category_id" ref="module_category_root_school_management_special"/>
        </record>
        <record id="group_dashboard_timetable" model="res.groups">
            <field name="name">Timetable</field>
            <field name="category_id" ref="module_category_root_school_management_special"/>
        </record>
        <record id="group_dashboard_team_points" model="res.groups">
            <field name="name">Team Points</field>
            <field name="category_id" ref="module_category_root_school_management_special"/>
        </record>


        <!-- Menu-routing group: assigned to student users but NOT implied by Teacher/Manager.
             Use this (instead of group_aps_student) on any menuitem that should be
             visible to pure students but hidden from teachers and managers. -->
        <record id="group_aps_student_menu" model="res.groups">
            <field name="name">Students</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Controls visibility of student-facing root menus. Not implied by Teacher or Manager.</field>
        </record>



    </data>
</odoo>